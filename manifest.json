{
  "manifest_version": 3,
  "name": "Scalemax Official",
  "description": "Scalemax Official — browser-only AI agent. Bring your own OpenAI-compatible LLM and let it work in your browser.",
  "homepage_url": "https://github.com/Sagar3079/scalemax-chrome-extension",
  "version": "1.1.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "96": "icon/96.png",
    "128": "icon/128.png"
  },
  "key": "",
  "default_locale": "en",
  "permissions": [
    "tabs",
    "tabGroups",
    "activeTab",
    "scripting",
    "contextMenus",
    "downloads",
    "webRequest",
    "webNavigation",
    "debugger",
    "history",
    "bookmarks",
    "offscreen",
    "storage",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "open_in_tab": false,
    "page": "options.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scalemax Official"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "toggle_web_editor": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Toggle Web Editor mode"
    },
    "toggle_quick_panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Toggle Quick Panel AI Chat"
    }
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:;"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "js": [
        "content-scripts/element-picker.js",
        "content-scripts/quick-panel.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "js": [
        "content-scripts/translate.js"
      ]
    }
  ]
}
